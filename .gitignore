# ═══════════════════════════════════════
# Economics Hub — .gitignore
# ═══════════════════════════════════════

# ── API KEYS & SECRETS ──
.env
.streamlit/secrets.toml
**/secrets*
**/*api_key*

# ── Python ──
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# ── Virtual Environment ──
.venv/
venv/
env/

# ── Output (generated charts — don't bloat the repo) ──
output/
docs/
instructions.md
project_context.md

# ── OS Files ──
.DS_Store
Thumbs.db
Desktop.ini

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo

# ── Jupyter (if you ever use it) ──
.ipynb_checkpoints/
