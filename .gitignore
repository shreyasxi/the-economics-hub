# ═══════════════════════════════════════
# Economics Hub — .gitignore
# ═══════════════════════════════════════

# ── API KEYS & SECRETS ──
.claude
.env
.streamlit/secrets.toml
**/secrets*
**/*api_key*

# ── Python ──
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# ── Virtual Environment ──
.venv/
venv/
env/

# ── Output (generated charts — don't bloat the repo) ──
output/
docs/

# ── OS Files ──
.DS_Store
Thumbs.db
Desktop.ini

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo

# ── Jupyter (if you ever use it) ──
.ipynb_checkpoints/

# ── local data, cache, logs ──
data/rbi_sentinel_cache/
data/nse_valuations/runs/
data/nse_indices/runs/
data/NIFTY 50/
data/NIFTY Small Cap 250/

# ── RBI Bulletin, State of the Economy — downloaded article pages ──
data/rbi_soe_cache/

# Ignore SQLite temp files
*.db-shm
*.db-wal
