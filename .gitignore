# ═══════════════════════════════════════
# Economics Hub — .gitignore
# ═══════════════════════════════════════

# ── API KEYS & SECRETS ──
.claude
.env
.streamlit/secrets.toml
**/secrets*
**/*api_key*

# ── Python ──
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
manual_india_update.py

# ── Virtual Environment ──
.venv/
venv/
env/

# ── Output (generated charts — don't bloat the repo) ──
output/
docs/
instructions.md
project_context.md
RBI_SENTINEL_DOCS.md

# ── OS Files ──
.DS_Store
Thumbs.db
Desktop.ini

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo

# ── Jupyter (if you ever use it) ──
.ipynb_checkpoints/

# ── RBI Sentinel — local data, cache, logs ──
data/rbi_sentinel_cache/
logs/

# Ignore SQLite temp files
*.db-shm
*.db-wal