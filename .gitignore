# ═══════════════════════════════════════
# Economics Hub — .gitignore
# ═══════════════════════════════════════

# ── API KEYS & SECRETS ──
.claude
.env
.streamlit/secrets.toml
**/secrets*
**/*api_key*

# ── Python ──
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# ── Virtual Environment ──
.venv/
venv/
env/

# ── Output (generated charts — don't bloat the repo) ──
output/
docs/*
!docs/project_context.md

# ── OS Files ──
.DS_Store
Thumbs.db
Desktop.ini

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo

# ── Jupyter (if you ever use it) ──
.ipynb_checkpoints/

# ── local data, cache, logs ──
data/cache/
data/stores/india/nse_valuations/runs/
data/stores/india/nse_indices/runs/
data/inputs/nse/NIFTY 50/
data/inputs/nse/NIFTY Small Cap 250/

# Ignore SQLite temp files
*.db-shm
*.db-wal

.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.mypy_cache/
data/**/*.tmp
data/**/.update.lock
data/stores/india/nse_valuations/start_investigation.json
