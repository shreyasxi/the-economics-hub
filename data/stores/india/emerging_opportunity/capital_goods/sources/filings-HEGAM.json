[{"broadcastDate":"15-OCT-2026 12:20:35","cgTimeStamp":null,"countString":null,"date":"30-SEP-2026","desc":"NEW_1","employeeTrusts":"0","format":null,"index":"-","industry":"-","isin":"INE545A01016","name":"HEG Advanced Materials Limited","newColumn":true,"pr_and_prgrp":"60.72","promoterDematNotes":"","publicShareholdingNotes":"","public_val":"39.28","recordId":"214513","remarksWeb":"Pursuant to the Order dated August 13, 2026 passed by the Hon'ble National Company Law Tribunal, Indore Bench sanctioning the Composite Scheme of Arrangement amongst HEG Limited (presently HEG Advanced Materials Limited) (Company or Transferee Company or Demerged Company) and HEG Graphite Limited (Resulting Company) and Bhilwara Energy Limited (Transferor Company) and their respective shareholders and creditors under Sections 230 to 232 and other applicable provisions of the Companies Act, 2013 (Act) (Scheme), Company has allotted 13,68,21,382 equity shares of face value of Rs. 2 each on September 8, 2026, in ratio of 8 fully paid up equity shares of Rs. 2 each of the Transferee Company (Transferee Company New Equity Shares), credited as fully paid up, for every 7 equity shares of Rs. 10 each of the Transferor Compony; to the eligible members of the Transferor Company determined as on the Effective Date i.e. Tuesday, September 1, 2026.   The Company has received listing approval from BSE and NSE on September 22, 2026 for listing of the equity shares issued pursuant to the Scheme. After listing approval, shares got credited in respective demat account but in temporary ISIN till receipt of trading approval. Upon receipt of trading approval on October 8, 2026 for trading effective on October 9, 2026, the shares transferred from temporary ISIN to permanent ISIN.","revisedData":"N","revisedDate":null,"revisedRemark":null,"revisedStatus":"-","revisionDate":null,"revisionRemark":null,"shareholdingPatternNotes":"","submissionDate":"15-OCT-2026","symbol":"HEGAM","systemDate":"15-OCT-2026 12:20:4