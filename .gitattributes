# ═══════════════════════════════════════════════════════════
# Economics Hub — line-ending and diff policy
# Repo moved Windows → macOS; normalise once, then stay LF.
# ═══════════════════════════════════════════════════════════

# Default: detect text, store and check out LF
* text=auto eol=lf

# Explicit text
*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.sql   text eol=lf
*.csv   text eol=lf
*.txt   text eol=lf
*.json  text eol=lf

# Binary — never touch, never diff as text
*.png   binary
*.jpg   binary
*.jpeg  binary
*.db    binary
*.xlsx  binary
*.xls   binary
*.pdf   binary
*.ico   binary

# Audited NSE CSV bytes are checksum-verified; preserve source line endings.
data/stores/india/nse_indices/raw/*.csv -text
data/stores/india/nse_indices/signals/*.csv -text
data/stores/india/nse_valuations/*.csv -text
data/stores/india/nse_valuations/sources/**/raw.csv -text

# Official fiscal source HTML and PDF-extracted text retain source whitespace.
data/inputs/fiscal_interest/sources/*.html -text -whitespace
data/inputs/fiscal_interest/sources/*.txt -whitespace
data/inputs/gst/sources/*.txt -whitespace

# Emerging Opportunity source bytes are checksum-verified before display.
data/stores/india/emerging_opportunity/**/sources/** -text -whitespace
tests/fixtures/emerging_opportunity/*.gz binary

# Portfolio releases contain byte-level manifests; preserve producer bytes on every OS.
data/published/portfolio_lab/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
